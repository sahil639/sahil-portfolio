---
import { render } from "astro:content";
import { YouTube } from "@astro-community/astro-embed-youtube";
import { Tweet } from "@astro-community/astro-embed-twitter";
import Base from "../../layouts/Base.astro";
import Img from "../../components/Img.astro";
import Gallery from "../../components/Gallery.astro";
import Callout from "../../components/Callout.astro";
import Figma from "../../components/Figma.astro";
import LinkCard from "../../components/LinkCard.astro";
import A from "../../components/A.astro";
import { getPosts, niceDate, isoDate, wordsToMinutes } from "../../lib/posts.js";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { title, date, summary, cover, tags, draft } = post.data;
const { Content } = await render(post);
const SITE = "https://sahildesign.xyz";
const url = `${SITE}/blog/${post.id}/`;
const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description: summary,
  datePublished: isoDate(date),
  url,
  image: cover ? new URL(cover, SITE).href : `${SITE}/images/og.png`,
  keywords: tags.join(", "),
  author: { "@type": "Person", name: "Sahil Pednekar", url: `${SITE}/` },
};
const components = { a: A, Img, Gallery, Callout, Figma, LinkCard, YouTube, Tweet };
---
<Base title={`${title} — Sahil Pednekar`} description={summary || title} image={cover} type="article" wide current="blog">
  <Fragment slot="head">
    <meta property="article:published_time" content={isoDate(date)}>
    {tags.map((t) => <meta property="article:tag" content={t}>)}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, "\\u003c")} />
  </Fragment>

  <article class="post">
    <a class="ulink back" href="/blog/">← ALL POSTS</a>
    <p class="meta">
      <time datetime={isoDate(date)}>{niceDate(date)}</time> · {wordsToMinutes(post.body)} MIN READ
      {draft && <span class="draft">DRAFT — HIDDEN ON THE LIVE SITE</span>}
    </p>
    <h1>{title}</h1>
    {summary && <p class="lede">{summary}</p>}
    {tags.length > 0 && <p class="tags">{tags.map((t) => <a class="tag" href={`/blog/?tag=${encodeURIComponent(t)}`}>#{t}</a>)}</p>}
    {cover && <div class="post-cover"><Img src={cover} alt="" size="wide" eager /></div>}
    <div class="prose">
      <Content components={components} />
    </div>
  </article>

  {(newer || older) && (
    <nav class="post-nav" aria-label="More posts">
      {older && <a class="prev" href={`/blog/${older.id}/`}><span>← OLDER</span>{older.data.title}</a>}
      {newer && <a class="next" href={`/blog/${newer.id}/`}><span>NEWER →</span>{newer.data.title}</a>}
    </nav>
  )}

  <p class="the-end">Thanks for reading. <a href="https://x.com/sahil_pednekar3" target="_blank" rel="noopener">Say hi on X →</a></p>
</Base>
